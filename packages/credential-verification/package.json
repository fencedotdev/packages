{
  "name": "@fence.dev/credential-verification",
  "version": "0.1.1",
  "description": "Verify a Fence-issued passport's signature and offline revocation status against Fence's published did:web keys — the same logic Fence's own verification service uses, independently auditable by a relying party.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fencedotdev/packages.git",
    "directory": "packages/credential-verification"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@fence.dev/contracts": "^0.4.1",
    "jose": "^6.2.10"
  },
  "devDependencies": {
    "@types/node": "^26.3.0"
  }
}
